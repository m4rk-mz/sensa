# Copia este archivo como .env y llena los valores.
# .env no se sube a GitHub (ver .gitignore).

# --- Supabase ---------------------------------------------------------------
# Project Settings -> API en el panel de Supabase.
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# service_role key: solo en el servidor. Nunca en la app Flutter.
SUPABASE_SERVICE_KEY=

# --- Sesión -----------------------------------------------------------------
# Genera uno con: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
JWT_EXP_MINUTES=720

# --- Reglas de negocio ------------------------------------------------------
MANUAL_MODE_MINUTES=30
COMMAND_TIMEOUT_SECONDS=15
DEFAULT_THRESHOLD_C=27.0

# --- Tarea programada -------------------------------------------------------
TIMEZONE=America/Mexico_City
DAILY_REPORT_HOUR=0
DAILY_REPORT_MINUTE=10
ENABLE_SCHEDULER=true

# --- App --------------------------------------------------------------------
# Lista separada por comas, o * para cualquier origen (solo en desarrollo).
CORS_ORIGINS=*
